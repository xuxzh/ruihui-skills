# 禅道（ZenTao）凭证模板
#
# ⚠️ 本文件会提交到公开仓库，只能保留占位符。真实值写入 .env（已被 .gitignore 忽略，不要提交）。
# 用法：cp .env.example .env，然后填写真实值。
#
# 认证路径：终端用户在本机凭据文件里写账号密码 → 入口脚本（skills/rh-product-feedback/scripts/zentao.mjs）
# 向 `POST <站点>/api.php/v1/tokens` 换当次令牌 → 以 ZENTAO_URL / ZENTAO_ACCOUNT / ZENTAO_TOKEN
# 经环境变量注入官方禅道 CLI 子进程。令牌不进命令行参数、不落盘、不进 Agent 上下文。
# 技能包随包分发的 config.local.json 里也有同样的三个变量含义的站点地址与 CLI 版本锁；
# 本文件只给本仓库的开发与测试用。

# 禅道登录账号
ZENTAO_ACCOUNT=<zentao-account>

# 禅道登录密码（禅道实例的账号密码）
ZENTAO_PASSWORD=

# 禅道 API token，可选。在禅道界面「个人 → 令牌」生成；填写后优先于账号密码，不再换令牌。
ZENTAO_TOKEN=

# 禅道站点地址（API 前缀：<ZENTAO_BASE_URL>/api.php/v1）。入口脚本换令牌用它，
# 打包脚本把它转成 config.local.json 的 zentaoWebUrl。
ZENTAO_BASE_URL=<internal-zentao-base-url>

# 真实端到端测试的写入闸门（见 docs/adr/0003）。三项都满足才允许写入禅道：
# 显式开关、目标产品、允许写入的产品白名单。测试数据带唯一标识，验证后删除。
# 具体产品 ID 与名称属于内部信息，不写进公开仓库，这里只留占位符。
ZENTAO_E2E_ALLOW_WRITE=1
ZENTAO_E2E_PRODUCT=<pilot-product-id>
ZENTAO_E2E_ALLOWED_PRODUCTS=<pilot-product-id>
